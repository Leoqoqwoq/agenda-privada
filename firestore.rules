rules_version = '2';

/**
 * Regras restritivas da Agenda Privada.
 *
 * IMPORTANTE: substitua AUTHORIZED_UID_AQUI pelo UID real da proprietária
 * (Firebase Console → Authentication → Users → User UID).
 *
 * Publicar:
 *   firebase deploy --only firestore:rules
 *
 * Testar no Rules Playground (Console → Firestore → Rules → Rules Playground)
 * ou com o Emulator Suite.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    // UID autorizado da proprietária da agenda — altere antes de publicar
    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'AUTHORIZED_UID_AQUI';
    }

    function isOwnerPath(uid) {
      return isOwner() && request.auth.uid == uid;
    }

    function validAppointment() {
      return request.resource.data.keys().hasAll([
          'title', 'category', 'date', 'startTime', 'endTime',
          'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.category in [
          'cliente', 'consulta_medica', 'exame_medico',
          'compromisso_pessoal', 'outros'
        ]
        && request.resource.data.status in [
          'agendado', 'concluido', 'cancelado'
        ];
    }

    match /users/{userId} {
      allow read, create, update: if isOwnerPath(userId);
      allow delete: if false;

      match /appointments/{appointmentId} {
        allow read: if isOwnerPath(userId);
        allow create: if isOwnerPath(userId) && validAppointment();
        allow update: if isOwnerPath(userId) && validAppointment();
        allow delete: if isOwnerPath(userId);
      }

      match /clients/{clientId} {
        allow read, create, update, delete: if isOwnerPath(userId);
      }

      match /notifications/{notificationId} {
        allow read, create, update, delete: if isOwnerPath(userId);
      }

      match /fcmTokens/{tokenId} {
        allow read, create, update, delete: if isOwnerPath(userId);
      }
    }

    // Negação explícita para qualquer outro caminho
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
